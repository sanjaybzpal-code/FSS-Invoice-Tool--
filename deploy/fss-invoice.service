[Unit]
Description=FSS Invoice Tool
After=network.target postgresql.service postgresql-16.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fss-invoice
EnvironmentFile=/opt/fss-invoice/.env
ExecStart=/opt/fss-invoice/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --timeout 120 web:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
